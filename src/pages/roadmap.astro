---
import Button from '@/components/Button.astro';
import HandFrame from '@/components/HandFrame.astro';
import Illustration from '@/components/Illustration.astro';
import ParticipatingCenters from '@/components/ParticipatingCenters.astro';
import Section from '@/components/Section.astro';
import SplitHero from '@/components/SplitHero.astro';
import TextBlock from '@/components/TextBlock.astro';
import { roadmap } from '@/content/roadmap';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
    title="Roadmap and feedback"
    description="The current development priorities for Joyma: features ready for pilot testing, work in development and how to request a feature."
>
    <SplitHero heading={roadmap.hero.heading} highlight="Joyma" paragraphs={roadmap.hero.paragraphs}>
        <HandFrame slot="media" offset variant={1} class="bg-sunshine">
            <div class="flex aspect-[4/3] items-center justify-center p-10">
                <Illustration name="event-planning" class="max-w-[16rem]" loading="eager" />
            </div>
        </HandFrame>
    </SplitHero>

    <Section tone="warm">
        <TextBlock heading={roadmap.pilot.heading} paragraphs={[roadmap.pilot.intro]} class="max-w-[44rem]" />
        <div class="mt-10 grid gap-8 md:mt-14 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
            {
                roadmap.pilot.items.map((item, index) => (
                    <HandFrame variant={index} class="bg-ivory-light">
                        <article class="flex h-full flex-col gap-5 p-7 md:p-8">
                            <Illustration name={item.illustration} class="w-20 md:w-24" />
                            <h3 class="h3">{item.heading}</h3>
                            <p>{item.text}</p>
                        </article>
                    </HandFrame>
                ))
            }
        </div>

        <div id="participating-centers" class="mt-16 scroll-mt-28 md:mt-24">
            <TextBlock
                heading={roadmap.participatingCenters.heading}
                paragraphs={[roadmap.participatingCenters.intro]}
                class="max-w-[44rem]"
            />
            <ParticipatingCenters
                centers={roadmap.participatingCenters.centers}
                invitation={roadmap.participatingCenters.invitation}
                class="mt-10 md:mt-12"
            />
        </div>
    </Section>

    <Section tone="light">
        <div class="grid gap-8 md:grid-cols-3" data-reveal-group>
            {
                roadmap.nextSteps.map((step, index) => (
                    <HandFrame variant={index}>
                        <article class="flex h-full flex-col p-7 md:p-8">
                            <h2 id={step.id} class="h3">
                                {step.heading}
                            </h2>
                            <p class="mt-4">{step.text}</p>
                            <div class="mt-auto pt-7">
                                {step.link ? (
                                    <Button href={step.link.href}>{step.link.label}</Button>
                                ) : (
                                    <p class="inline-flex items-center gap-2 text-sm font-medium">
                                        <span class="h-2 w-2 rounded-full bg-coral" aria-hidden="true" />
                                        {step.status}
                                    </p>
                                )}
                            </div>
                        </article>
                    </HandFrame>
                ))
            }
        </div>
    </Section>
</BaseLayout>
