<script>
    /* Move the "next meeting" on once a meeting has ended, without anyone editing the page. */
    const now = Date.now();
    const cards = [...document.querySelectorAll<HTMLElement>('[data-next-session]')];
    const next = cards.find((card) => Date.parse(card.dataset.end ?? '') > now);
    for (const card of cards) card.hidden = card !== next;
    const none = document.querySelector<HTMLElement>('[data-next-none]');
    if (none) none.hidden = next !== undefined;
    for (const badge of document.querySelectorAll<HTMLElement>('[data-next-badge]')) {
        badge.hidden = badge.dataset.nextBadge !== next?.dataset.nextSession;
    }

    /* Close the "Add to calendar" menu when clicking elsewhere or pressing Escape. */
    const closeMenus = (except?: Element | null) => {
        for (const menu of document.querySelectorAll('details.addcal[open]')) {
            if (menu !== except) menu.removeAttribute('open');
        }
    };
    document.addEventListener('click', (event) => closeMenus((event.target as Element).closest('details.addcal')));
    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeMenus();
    });

    /* Highlight the section you are reading in the top nav. */
    const links = new Map<string, HTMLAnchorElement>();
    for (const link of document.querySelectorAll<HTMLAnchorElement>('.topnav a[href^="#"]')) {
        links.set((link.getAttribute('href') ?? '').slice(1), link);
    }
    const sections = document.querySelectorAll<HTMLElement>('section.band[id]');
    if (sections.length > 0 && 'IntersectionObserver' in window) {
        const visible = new Map<string, number>();
        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    visible.set(entry.target.id, entry.isIntersecting ? entry.intersectionRatio : 0);
                }
                let best: string | null = null;
                let bestRatio = 0;
                for (const [id, ratio] of visible) {
                    if (ratio > bestRatio) {
                        bestRatio = ratio;
                        best = id;
                    }
                }
                for (const [id, link] of links) {
                    link.classList.toggle('current', id === best);
                }
            },
            { rootMargin: '-81px 0px -55% 0px', threshold: [0, 0.15, 0.4, 0.75, 1] },
        );
        for (const section of sections) {
            observer.observe(section);
        }
    }
</script>
