---
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import { framePaths, horizontalRulePaths, verticalRulePaths } from '../lib/hand-paths';
import { MEETING, sessionViews } from '../lib/seeds-meetings';

/**
 * The Joyma Seeds hub: the home page for the pilot centers between monthly meetings.
 * It borrows only the Joyful Effort yellow, ivory neutrals and DM Sans; it does not use BaseLayout or the hand-drawn elements.
 */
const title = 'Joyma Seeds — everything in one place';
const description =
    'Joyma Seeds: meeting times, the test environment, what to test this month, where we need your input, past presentations and contacts.';
const canonical = new URL('/seeds', Astro.site);

// The main site's hand-drawn frames, rules and arrow (src/lib/hand-paths.ts, Arrow.astro), as CSS images,
// so this page can use them without the main site's Tailwind layout.
const INK = '#24211c';
const svgImage = (viewBox: string, paths: string, width: number) =>
    `url("data:image/svg+xml,${encodeURIComponent(
        `<svg xmlns="http://www.w3.org/2000/svg" viewBox="${viewBox}" preserveAspectRatio="none">${paths.replaceAll('<path ', `<path fill="none" stroke="${INK}" stroke-width="${width}" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" `)}</svg>`,
    )}")`;
const handImages = [
    ...framePaths.map(
        (d, i) => `--hand-frame-${i}:${svgImage('-1.5 -1.5 103 103', `<path d="${d}"/>`, 2)}`,
    ),
    ...horizontalRulePaths.map(
        (d, i) => `--hand-rule-h-${i}:${svgImage('0 -1 100 4', `<path d="${d}"/>`, 1.75)}`,
    ),
    ...verticalRulePaths.map(
        (d, i) => `--hand-rule-v-${i}:${svgImage('-1 0 4 100', `<path d="${d}"/>`, 1.75)}`,
    ),
    `--hand-arrow:${svgImage(
        '0 0 24 16',
        '<path d="M1.5 8.3 C 8 7.8, 15 8.4, 21.5 8"/><path d="M15.2 2.2 C 17.4 4.2, 19.6 6.4, 21.8 8 C 19.5 9.8, 17.3 11.8, 15.4 13.9"/>',
        1.75,
    ).replace('preserveAspectRatio%3D%22none%22', '')}`,
];
const handStyle = `<style>:root{${handImages.join(';')}}</style>`;

// The next meeting is chosen at build time, and the page script moves it on after each meeting.
const sessions = sessionViews();
const buildTime = Date.now();
const nextNumber = sessions.find((s) => s.end.getTime() > buildTime)?.number;
// Section 1 shows the usual local times, taken from the next session (or the last listed one).
const usualTimes = (sessions.find((s) => s.number === nextNumber) ?? sessions[sessions.length - 1])
    .times;
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="noindex" />
<link rel="canonical" href={canonical} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.png" type="image/png" />
<Fragment set:html={handStyle} />
<style is:global>
  /*
   * Colors, font and design elements from the Joyful Effort site: sunshine yellow, ivory and near-black,
   * DM Sans, square corners, flat surfaces, and hand-drawn frames, rules and arrows (the --hand-* images,
   * drawn from src/lib/hand-paths.ts in the frontmatter).
   */
  :root{
    --sunshine:#f6c945; --ivory:#fbf8f1; --ink:#24211c;
    --foreground:var(--ink); --text:var(--ink); --text-muted:#625c51;
    --primary:var(--sunshine); --primary-foreground:var(--ink); --primary-hover:#ecbb2c;
    --secondary-foreground:#4d4126; --muted:#f1ebdd; --muted-foreground:#776f60;
    --border:rgba(36,33,28,.12);
    --font-sans:"DM Sans",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
  body{
    font-family:var(--font-sans);background:var(--ivory);color:var(--text);
    font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;
  }
  img{max-width:100%}
  [hidden]{display:none !important}

  /* ============ hand-drawn frames and rules ============ */
  /* A frame sits just outside its box, so the strokes overshoot the corners as on the main site. */
  .card,.tablebox,.callout,.next,.addcal-menu,.grid.g2{position:relative}
  .card::after,.tablebox::after,.callout::after,.next::after,.addcal-menu::after,.grid.g2::after{
    content:"";position:absolute;inset:-1.5%;pointer-events:none;
    background:var(--hand-frame-0) 0 0/100% 100% no-repeat;
  }
  .tablebox::after,.next::after{background-image:var(--hand-frame-1)}
  .callout::after,.addcal-menu::after,.grid.g2::after{background-image:var(--hand-frame-2)}

  /* ============ header ============ */
  .topbar{
    position:sticky;top:0;z-index:40;background:rgba(251,248,241,.95);
    border-bottom:1px solid var(--border);backdrop-filter:blur(8px);
  }
  .bar{
    max-width:1180px;margin:0 auto;padding:10px 24px;
    display:flex;align-items:center;justify-content:space-between;gap:10px 18px;
    min-height:80px;flex-wrap:wrap;
  }
  .logo{display:flex;align-items:center;gap:9px;text-decoration:none;flex:none}
  .logo span{font-size:28px;font-weight:600;color:var(--foreground);letter-spacing:-.02em;line-height:1}
  .topnav{display:flex;align-items:center;gap:4px 18px;flex-wrap:wrap}
  .topnav a{
    color:var(--foreground);text-decoration:none;font-size:15px;font-weight:500;
    padding:10px 2px;white-space:nowrap;text-underline-offset:6px;
  }
  .topnav a:hover,.topnav a.current{text-decoration:underline;text-decoration-thickness:1.5px}
  .topnav a.accent{background:var(--primary);color:var(--primary-foreground);padding:10px 18px;margin-left:6px}
  .topnav a.accent:hover{text-decoration:none;background:var(--primary-hover)}

  /* ============ bands: ivory and yellow in turn, as on the main site ============ */
  .band{padding:84px 0;scroll-margin-top:81px}
  .band--alt{background:var(--sunshine)}
  .wrap{max-width:1180px;margin:0 auto;padding:0 24px}

  /* ============ hero ============ */
  .hero{padding:60px 0 68px;background:var(--sunshine)}
  h1{
    font-size:clamp(38px,5.4vw,64px);font-weight:600;color:var(--foreground);
    letter-spacing:-.025em;line-height:1.05;margin-bottom:24px;
  }
  .hero .sub{font-size:16.5px;color:var(--secondary-foreground);max-width:72ch}
  .hero .sub + .sub{margin-top:10px}
  .hero .stamp{
    display:inline-flex;align-items:center;gap:8px;margin-top:22px;
    font-size:13px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--secondary-foreground);
  }
  .hero .stamp svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:1.8}

  /* ============ labels: small capitals in place of pills ============ */
  .label,.subhead,.next-eyebrow,.secnum,.badge,th{
    font-size:13px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;line-height:1.4;
  }

  /* ============ section headers ============ */
  .sechead{position:relative;margin-bottom:36px;padding-bottom:26px}
  .sechead::after{
    content:"";position:absolute;left:0;right:0;bottom:-2px;height:4px;pointer-events:none;
    background:var(--hand-rule-h-1) 0 0/100% 100% no-repeat;
  }
  .eyebrow{display:flex;flex-direction:column;align-items:flex-start;gap:10px;margin-bottom:12px}
  .secnum{color:var(--secondary-foreground)}
  h2{
    font-size:clamp(30px,3.8vw,44px);font-weight:600;color:var(--foreground);
    letter-spacing:-.022em;line-height:1.1;margin-bottom:10px;
  }
  .sechead h2:last-child{margin-bottom:0}
  .sechead .sub{font-size:16.5px;color:var(--text-muted);max-width:78ch}
  .band--alt .sechead .sub{color:var(--secondary-foreground)}
  .sechead .sub + .sub{margin-top:9px}
  .subhead{color:var(--secondary-foreground);margin:0 0 14px}

  .topic{margin-bottom:36px}
  .topic:last-child{margin-bottom:0}

  /* ============ cards: flat panels in a hand-drawn frame ============ */
  .grid{display:grid;gap:24px}
  .g2{grid-template-columns:repeat(2,1fr)}
  .g3{grid-template-columns:repeat(3,1fr)}
  .card{background:var(--ivory);display:flex;flex-direction:column}
  .card .body{padding:28px 30px;display:flex;flex-direction:column;flex:1}
  .card h3{
    font-size:21px;font-weight:600;color:var(--foreground);
    letter-spacing:-.015em;line-height:1.25;margin-bottom:10px;
  }
  .card h4{
    font-size:19px;font-weight:600;color:var(--foreground);
    letter-spacing:-.01em;line-height:1.25;margin:0 0 10px;
  }
  .card p{font-size:15.5px;color:var(--text-muted)}
  .card p + p{margin-top:10px}
  .card p strong{color:var(--foreground);font-weight:600}
  .card.sand{background:var(--sunshine)}
  .card.sand p{color:var(--secondary-foreground)}

  /* ============ hand-ruled grids (session and contact cards), like the main site's footer ============ */
  .grid.g2{gap:0;background:var(--ivory)}
  .grid.g2 > .card{background:none}
  .grid.g2 > .card::before,.grid.g2 > .card::after{content:"";position:absolute;pointer-events:none;inset:auto;display:none}
  .grid.g2 > .card::after{left:0;top:-2px;width:100%;height:4px;background:var(--hand-rule-h-0) 0 0/100% 100% no-repeat}
  .grid.g2 > .card:nth-child(4n+1)::after,.grid.g2 > .card:nth-child(4n+2)::after{background-image:var(--hand-rule-h-1)}
  .grid.g2 > .card::before{left:-2px;top:0;width:4px;height:100%;background:var(--hand-rule-v-0) 0 0/100% 100% no-repeat}
  .grid.g2 > .card:nth-child(4n)::before{background-image:var(--hand-rule-v-1)}
  .grid.g2 > .card:nth-child(n+3)::after{display:block}
  .grid.g2 > .card:nth-child(even)::before{display:block}

  /* ============ small capitals labels ============ */
  .badges{display:flex;flex-wrap:wrap;align-items:center;gap:6px 0;margin-bottom:12px}
  .badge{display:inline-flex;align-items:center;color:var(--secondary-foreground);white-space:nowrap}
  .badges .badge + .badge::before{content:"\00b7";margin:0 .7em;letter-spacing:0}
  .badge.solid,.badge.sand{background:var(--sunshine);color:var(--ink);padding:3px 8px 2px;letter-spacing:.14em}
  .badges .badge.solid + .badge::before,.badges .badge + .badge.sand::before,.badges .badge + .badge.solid::before{content:"";margin:0 .35em}

  /* ============ meta rows ============ */
  .meta{margin-top:auto;padding-top:16px;display:flex;flex-direction:column;gap:8px}
  .meta div{display:flex;align-items:center;gap:9px;font-size:14.5px;color:var(--text-muted)}
  .meta svg{width:16px;height:16px;flex:none;stroke:var(--muted-foreground);fill:none;stroke-width:1.7}

  /* ============ links and buttons ============ */
  a{color:var(--foreground);font-weight:600;text-decoration-color:var(--sunshine);text-decoration-thickness:2px}
  .band--alt a{text-decoration-color:var(--ink)}
  .prose a{text-decoration:underline;text-underline-offset:3px}
  .prose a:hover{text-decoration:none}
  .actions{display:flex;flex-wrap:wrap;align-items:center;gap:8px 28px;margin-top:18px}
  /* Secondary actions: the label and a hand-drawn arrow, as on the main site. */
  .btn{
    display:inline-flex;align-items:center;gap:10px;min-height:48px;padding:10px 0;
    font-size:15.5px;font-weight:500;color:var(--foreground);text-decoration:none;
    background:none;border:0;text-underline-offset:6px;cursor:pointer;
  }
  .btn:hover{text-decoration:underline;text-decoration-color:currentColor;text-decoration-thickness:1.5px}
  .btn::after{
    content:"";flex:none;width:1.25em;height:.9em;transition:transform .2s;
    background:var(--hand-arrow) center/contain no-repeat;
  }
  .btn:hover::after{transform:translateX(2px)}
  .btn svg{display:none}
  /* Main actions: a flat yellow block that lifts onto an offset shadow on hover. */
  .btn.solid{background:var(--primary);color:var(--primary-foreground);padding:12px 24px}
  .btn.solid::after{display:none}
  .btn.solid:hover,.topnav a.accent:hover{text-decoration:none;background:var(--primary-hover)}
  @media (prefers-reduced-motion:no-preference){
    .btn.solid,.topnav a.accent{transition:background-color .2s,transform .2s,box-shadow .2s}
    .btn.solid:hover,.topnav a.accent:hover{transform:translate(-2px,-2px);box-shadow:4px 4px 0 0 var(--ink)}
    .btn.solid:active,.topnav a.accent:active{transform:none;box-shadow:none;transition-duration:80ms}
  }
  @media (prefers-reduced-motion:reduce){.btn::after{transition:none}.btn:hover::after{transform:none}}

  /* ============ meeting times: plain text with hand-drawn dividers ============ */
  .tzrow{display:flex;flex-wrap:wrap;gap:8px 0}
  .tz{position:relative;padding:2px 18px;font-size:15px;color:var(--text-muted);white-space:nowrap}
  .tz:first-child{padding-left:0}
  .tz + .tz::before{
    content:"";position:absolute;left:-2px;top:0;bottom:0;width:4px;
    background:var(--hand-rule-v-0) 0 0/100% 100% no-repeat;
  }
  .tz:nth-child(odd) + .tz::before{background-image:var(--hand-rule-v-1)}
  .tz b{font-weight:600;color:var(--foreground)}
  .tz small{font-size:12.5px;margin-left:3px}
  .meet-join{margin:18px 0 32px}

  /* ============ next meeting, top of the hero ============ */
  .next{background:var(--ivory);padding:28px 30px;margin:0 0 32px;max-width:980px}
  .next-eyebrow{color:var(--secondary-foreground);margin-bottom:8px}
  .next-date{font-size:clamp(24px,3.2vw,32px);font-weight:600;letter-spacing:-.015em;line-height:1.15;color:var(--foreground);margin-bottom:16px}
  .next .actions{margin-top:20px}
  .next-note{margin-top:14px;font-size:14.5px;color:var(--text-muted)}
  .addcal{position:relative}
  .addcal summary{list-style:none}
  .addcal summary::-webkit-details-marker{display:none}
  .addcal summary::after{display:none}
  .addcal summary .chev{display:block;width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.8;transition:transform .15s}
  .addcal[open] summary .chev{transform:rotate(180deg)}
  .addcal-menu{
    position:absolute;left:0;top:calc(100% + 8px);z-index:5;min-width:270px;
    background:var(--ivory);padding:8px;display:flex;flex-direction:column;
  }
  .addcal-menu a{
    display:block;text-decoration:none;color:var(--foreground);font-size:15px;font-weight:500;
    padding:10px 12px;text-underline-offset:5px;
  }
  .addcal-menu a span{display:block;font-weight:400;font-size:13px;color:var(--text-muted)}
  .addcal-menu a:hover,.addcal-menu a:focus-visible{text-decoration:underline;text-decoration-color:currentColor}

  /* ============ lists ============ */
  .kinds{
    margin:24px 0 0;padding-left:1.15em;color:var(--text-muted);
    font-size:15.5px;max-width:80ch;
  }
  .band--alt .kinds{color:var(--secondary-foreground)}
  .kinds li + li{margin-top:8px}
  .kinds li::marker{color:var(--foreground)}
  .kinds strong{color:var(--foreground);font-weight:600}

  /* ============ tables: framed, with hand-drawn lines between rows ============ */
  .tablebox{background:var(--ivory)}
  .tw{overflow-x:auto;-webkit-overflow-scrolling:touch}
  table{width:100%;border-collapse:collapse;font-size:15.5px}
  th{text-align:left;color:var(--secondary-foreground);padding:18px 22px 14px;white-space:nowrap}
  tbody tr{background:var(--hand-rule-h-0) 0 0/100% 4px no-repeat}
  tbody tr:nth-child(even){background-image:var(--hand-rule-h-1)}
  td{padding:16px 22px;vertical-align:middle;color:var(--text-muted)}
  td strong{color:var(--foreground);font-weight:600}
  td .badge{margin-right:10px}
  td.nw{white-space:nowrap}
  td code{
    background:var(--muted);padding:3px 8px;font-size:13.5px;
    font-family:ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--secondary-foreground);white-space:nowrap;
  }

  /* ============ callouts ============ */
  .callout{padding:18px 22px;font-size:15.5px;margin-top:28px;background:var(--ivory);color:var(--secondary-foreground)}
  .callout a{color:inherit;text-decoration:underline;text-underline-offset:3px}
  .callout strong{font-weight:600}
  .note{margin-top:16px;font-size:15.5px;color:var(--text-muted);max-width:80ch}

  footer{background:var(--ivory)}
  .footin{
    position:relative;max-width:1132px;margin:0 auto;padding:30px 0 40px;text-align:center;
    color:var(--text-muted);font-size:14px;line-height:1.9;
  }
  .footin::before{
    content:"";position:absolute;left:0;right:0;top:-2px;height:4px;
    background:var(--hand-rule-h-1) 0 0/100% 100% no-repeat;
  }

  /* the longer nav labels need a little less room on mid-size screens */
  @media (max-width:1000px){
    .topnav{gap:2px 14px}
    .topnav a{font-size:14px}
  }
  @media (max-width:900px){
    .g3{grid-template-columns:1fr 1fr}
  }
  @media (max-width:760px){
    .bar{padding:14px 18px;justify-content:center}
    .topnav{justify-content:center;gap:0 14px}
    .wrap{padding:0 18px}
    .footin{margin:0 18px}
    .hero{padding:36px 0 44px}
    .band{padding:56px 0;scroll-margin-top:130px}
    .g2,.g3{grid-template-columns:1fr}
    .card .body,.next{padding:22px 20px}
    /* one column: a rule above every card after the first, and no side rules */
    .grid.g2 > .card:nth-child(n+2)::after{display:block}
    .grid.g2 > .card:nth-child(even)::before{display:none}
    .tzrow{flex-direction:column;gap:2px}
    .tz{padding:0}
    .tz + .tz::before{display:none}
  }
</style>
</head>
<body>
<div class="topbar">
  <div class="bar">
    <a class="logo" href="#top" aria-label="Joyma Seeds home">
      <span>joyma</span>
    </a>
    <nav class="topnav">
      <a href="#dates">Upcoming meetings</a>
      <a href="#testing">Test environment</a>
      <a href="#do">What to test</a>
      <a href="#questions">Your input</a>
      <a href="#roadmap">Roadmap</a>
      <a href="#meetings">Previous sessions</a>
      <a href="#contact" class="accent">Contact</a>
    </nav>
  </div>
</div>

<main id="top">

  <!-- ============ HERO ============ -->
  <div class="hero">
    <div class="wrap">
      <h1>Joyma Seeds</h1>

      {sessions.map((s) => (
        <div class="next" data-next-session={String(s.number)} data-end={s.end.toISOString()} hidden={s.number !== nextNumber}>
          <div class="next-eyebrow">Next meeting &middot; Session {s.number}</div>
          <div class="next-date">{s.longDate}</div>
          <div class="tzrow">
            {s.times.map((t) => (
              <span class="tz"><b>{t.time}</b> {t.label}{t.nextDay && <small>(Thursday)</small>}</span>
            ))}
          </div>
          <div class="actions">
            <a class="btn solid" href={MEETING.joinUrl} target="_blank" rel="noopener"><svg viewBox="0 0 24 24"><path d="M15 10l5-3v10l-5-3"/><rect x="3" y="6" width="12" height="12" rx="2"/></svg> Join the meeting</a>
            <details class="addcal">
              <summary class="btn"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18M12 14v4M10 16h4"/></svg> Add to calendar <svg class="chev" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg></summary>
              <div class="addcal-menu">
                <a href={s.googleUrl} target="_blank" rel="noopener">Google Calendar<span>Opens Google Calendar with the meetings filled in</span></a>
                <a href={MEETING.calendarPath}>Apple Calendar, Outlook and others<span>Downloads a calendar file (.ics)</span></a>
              </div>
            </details>
          </div>
          <p class="next-note">Every first Wednesday: a one-hour structured session, and if you would like to stay on and chat afterwards, we are always happy to. Every session is recorded, so we don&rsquo;t miss any of your helpful feedback.</p>
        </div>
      ))}
      <div class="next" data-next-none hidden={nextNumber !== undefined}>
        <div class="next-eyebrow">Next meeting</div>
        <div class="next-date">The next dates will be posted here soon</div>
        <div class="actions">
          <a class="btn" href={MEETING.joinUrl} target="_blank" rel="noopener">Meeting link</a>
        </div>
      </div>

      <p class="sub">Hello, dear pilot centers. Thank you for everything you are contributing to this project &mdash; your time, insights, requests and feedback. That is what will make this platform useful for as many dharma centers as possible.</p>
      <p class="sub prose"><strong>Lotus has a new name: Joyma.</strong> Same platform, same team, same Seeds program &mdash; only the name has changed. You can find it at <a href="https://joyma.co" target="_blank" rel="noopener">joyma.co</a>. Your test environment logins stay the same; the monthly meeting has a <a href="#dates">new link</a> from December.</p>
      <p class="sub prose">Each monthly meeting is where we demo updates and new features. This page is your hub in between: <a href="#do">what to test</a>, and <a href="#questions">where we still need your input</a>, so your feedback can go on that month's list and be built &mdash; or at least addressed &mdash; when we meet next. You'll also find meeting times, past presentations, and how to get in.</p>
      <span class="stamp">
        <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18"/></svg>
        Updated November 7, 2026
      </span>
    </div>
  </div>

  <!-- ============ 01 · UPCOMING MEETINGS ============ -->
  <section class="band" id="dates">
    <div class="wrap">
      <header class="sechead">
        <div class="eyebrow"><span class="secnum">01</span> <h2>Monthly Meeting: every 1st Wednesday</h2> </div>
        <p class="sub">The monthly meeting is a gathering to share what we have built and changed, including updates based on your feedback, and to hear more of your insights about digital work and service at Dharma centers.</p>
      </header>

      <div class="tzrow">
        {usualTimes.map((t) => (
          <span class="tz"><b>{t.time}</b> {t.label}{t.nextDay && <small>(Thursday)</small>}</span>
        ))}
      </div>

